{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "trailingComma": "es5",
  "ignorePatterns": [
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/.source",
    "**/dist",
    "**/build",
    "pnpm-lock.yaml"
  ],
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      "type",
      ["parent", "sibling", "index"],
      "internal"
    ],
    "internalPattern": ["^@/"],
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./packages/design-system/styles/globals.css",
    "functions": ["cn", "cva", "clsx", "twMerge"]
  }
}
