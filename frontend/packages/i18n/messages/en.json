    "privacy": {
      "title": "Privacy notice",
      "intro": "This platform is a research environment for a doctoral study on adaptive tutoring in virtual network labs. This notice describes what it records about you, why, and what you can do about it.",
      "collectHeading": "What is recorded",
      "collectBody": "Your account details from sign-up, the labs you launch, and what happens inside them: the state of the devices you configure, the checks that pass or fail, your messages to the tutor, and timing. Nothing outside the lab environment is recorded.",
      "purposeHeading": "Why",
      "purposeBody": "Two purposes, kept apart. Running the platform needs your account and your progress. The research needs the behavioural record, and only if you agreed to take part. Declining changes nothing about your access to the labs.",
      "pseudonymityHeading": "Pseudonymous, not anonymous",
      "pseudonymityBody": "Research records are analysed under a study identifier rather than your name or address. That identifier can still be traced back to you through a single restricted link, which is what makes it possible to answer an export or deletion request. We do not describe this data as anonymous, because it is not.",
      "retentionHeading": "How long",
      "retentionBody": "Research records are kept for the duration of the study and its publication. Operational logs of the control loop are removed after 90 days. Deleting your account removes both.",
      "rightsHeading": "Your rights",
      "rightsBody": "You can see everything held about you, have it deleted, withdraw from the study at any time, or use the labs without taking part at all. Withdrawing stops future collection; deletion removes what was already collected.",
      "exerciseHeading": "How to act on this",
      "exerciseBody": "Export, deletion and study participation are all in your account settings:",
      "exerciseLink": "open settings"
    },
    "terms": {
      "title": "Terms of use",
      "intro": "A short statement of what this platform is and how it may be used.",
      "accessHeading": "Access",
      "accessBody": "Accounts are approved individually. Signing up requests access; it does not grant it. Access may be withdrawn at any time.",
      "acceptableHeading": "Acceptable use",
      "acceptableBody": "The lab environments are for learning the exercises they contain. Do not use them to reach systems outside the lab, to run workloads unrelated to the exercise, or to attempt to reach another participant's environment.",
      "environmentHeading": "Your lab environment",
      "environmentBody": "Each session is temporary. An environment left idle is paused, and every session ends at its deadline. Configuration you save inside a device survives a pause; anything else may not.",
      "availabilityHeading": "Availability",
      "availabilityBody": "This is a research deployment on a single machine, not a production service. It may be unavailable, restarted, or reset without notice.",
      "liabilityHeading": "No warranty",
      "liabilityBody": "The platform is provided as is, without warranty. Do not store anything here that you cannot afford to lose."
    }
  },
