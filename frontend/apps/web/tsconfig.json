{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["./shared/lib/*"],
      "@/app-components/*": ["./app/_components/*"],
      "@/mdx-components": ["./mdx-components.tsx"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "next.config.ts"
  ],
  "exclude": ["node_modules"]
}
