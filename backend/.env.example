ENVIRONMENT=local
DEBUG=true
API_PORT=8000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
LOG_LEVEL=INFO

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onlinetlabs
DB_SQL_ECHO=false

REDIS_URL=redis://localhost:6379/0

# LLM providers. Yandex directly (Federal Law 152-FZ), OpenRouter for the remaining models.
YANDEX_API_KEY=
YANDEX_FOLDER=
# OpenRouter (optional). Without a key, OpenRouter models are hidden from the catalog
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=
# Default models per surface (ids from the config/llm_catalog.py catalog)
AGENTS_CHAT_MODEL=yandex-gpt-5.1
AGENTS_INTERVENTION_MODEL=yandex-gpt-5.1
AGENTS_INTERVENTIONS_FOLLOW_SESSION=false
# Maximum number of agent activity events per session (observability)
OBSERVABILITY_RETENTION_PER_SESSION=2000

# GNS3 integration
# SERVICE_URL/PUBLIC_URL reached from host + student browser.
# INTERNAL_URL is consumed by the gns3-mcp container -> use docker service name.
GNS3_SERVICE_URL=http://localhost:8101
GNS3_PUBLIC_URL=http://localhost:3080
GNS3_INTERNAL_URL=http://gns3-server:3080
MCP_SERVER_URL=http://localhost:8100

# Fernet key (44-char base64) for encrypting GNS3 credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENCRYPTION_KEY=
